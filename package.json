{
  "name": "resecarc",
  "version": "0.5.1",
  "description": "Browser-based designer for OT network architectures: Purdue levels, IEC 62443 zones, industrial protocol flows, firewall rules, IP plans and revisions.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/check-bundle.mjs",
    "e2e": "playwright test",
    "readme:images": "playwright test --config playwright.readme.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.66.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
